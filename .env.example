# Copy to .env.local in apps/web

# ─── AI providers ──────────────────────────────────────────────
# Google Gemini — needed for vision/PDF understanding.
#   Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here

# Groq — free, blazing fast, text-only. Llama 3.3 70B / 3.1 8B.
#   Free key: https://console.groq.com/keys
#   When set, text-only chat/grade/diagnostic will route through Groq.
#   Vision (image/PDF) always stays on Gemini.
GROQ_API_KEY=

# OpenRouter (optional) — aggregator with a rotating free tier.
#   Free key: https://openrouter.ai/keys
#   If set AND Groq is not, text queries route through OpenRouter's free Llama.
OPENROUTER_API_KEY=

# Which text model to prefer when multiple providers are configured.
# Values: "auto" (pick first available), "gemini", "groq", "openrouter"
AI_TEXT_PROVIDER=auto

# Supabase (https://supabase.com) - optional for M1, needed from M2
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Rate limit knobs
RL_GUEST_PER_DAY=10
RL_USER_PER_DAY=50
RL_UPLOAD_PER_DAY=5

# ─── Google Classroom integration (optional) ───
# 1. Google Cloud Console → new project → enable "Google Classroom API"
# 2. OAuth consent screen → external → add scopes below
# 3. Create OAuth 2.0 Client (Web application) → redirect URI:
#      http://localhost:3000/api/classroom/callback
# 4. Paste client id + secret here
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/classroom/callback

# ─── Microsoft Teams / Graph integration (optional) ───
# Azure Portal → App registration → add redirect URI:
#   http://localhost:3000/api/teams/callback
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common
MS_REDIRECT_URI=http://localhost:3000/api/teams/callback
